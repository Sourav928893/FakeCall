<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_bg_black">

    <!-- Top Section -->
    <TextView
        android:id="@+id/tvFakeCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="The Future"
        android:textColor="@color/text_white"
        android:textSize="42sp"
        android:fontFamily="sans-serif-light"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvIncomingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="is calling"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:letterSpacing="0.05"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFakeCallerName" />

    <!-- Middle Section: Clean and Minimal -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvIncomingLabel"
        app:layout_constraintBottom_toTopOf="@id/rowOptions" />

    <!-- Bottom Options Row 1 -->
    <LinearLayout
        android:id="@+id/rowOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="2"
        app:layout_constraintBottom_toTopOf="@id/rowButtons">

        <LinearLayout
            android:id="@+id/btnRemindMe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_remind"
                app:tint="@color/text_white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Remind Me"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_message"
                app:tint="@color/text_white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Message"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Buttons Row 2 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Decline -->
        <FrameLayout
            android:id="@+id/flDecline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/btnDecline"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_circle_red"
                android:elevation="4dp" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:elevation="5dp"
                android:rotation="135"
                android:src="@drawable/ic_call_decline"
                app:tint="@color/text_white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Decline"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/flDecline"
            app:layout_constraintStart_toStartOf="@id/flDecline"
            app:layout_constraintTop_toBottomOf="@id/flDecline" />

        <!-- Accept -->
        <FrameLayout
            android:id="@+id/flAccept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/pulseAccept"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_circle_green"
                android:alpha="0.4" />

            <View
                android:id="@+id/btnAccept"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_circle_green"
                android:elevation="4dp" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:elevation="5dp"
                android:src="@drawable/ic_call_accept"
                app:tint="@color/text_white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Accept"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/flAccept"
            app:layout_constraintStart_toStartOf="@id/flAccept"
            app:layout_constraintTop_toBottomOf="@id/flAccept" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
